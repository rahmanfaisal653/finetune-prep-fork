<script setup>
import { computed, onMounted, ref } from 'vue'
import { RouterLink, RouterView, useRoute, useRouter } from 'vue-router'

const router = useRouter()
const route = useRoute()
const sessions = ref([])
const nav = [
  { to: '/chat', label: 'Chat', icon: 'chat' },
  { to: '/knowledge', label: 'Knowledge', icon: 'database' },
  { to: '/settings', label: 'Settings', icon: 'settings' },
]

const activeChat = computed(() => route.path === '/chat')

function loadSessions() {
  try {
    sessions.value = JSON.parse(localStorage.getItem('chat_sessions') || '[]')
  } catch {
    sessions.value = []
  }
}

onMounted(() => {
  loadSessions()
  window.addEventListener('chat-sessions-updated', loadSessions)
})

function newChat() {
  const id = Date.now().toString()
  sessions.value.unshift({ id, title: 'New conversation', messages: [] })
  localStorage.setItem('chat_sessions', JSON.stringify(sessions.value))
  window.dispatchEvent(new Event('chat-sessions-updated'))
  router.push(`/chat?id=${id}`)
}
</script>

<template>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-mark"><span></span><span></span><span></span></div>
        <div><strong>Sentinel</strong><small>RAG workspace</small></div>
      </div>

      <button class="new-chat" @click="newChat">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        New conversation
      </button>

      <nav class="nav-list" aria-label="Main navigation">
        <RouterLink v-for="item in nav" :key="item.to" :to="item.to" class="nav-item" :class="{ active: route.path === item.to }">
          <svg v-if="item.icon === 'chat'" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15a4 4 0 0 1-4 4H8l-4 3v-7a4 4 0 0 1-2-3.5V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z" /><path d="M7 10h10M7 14h6" /></svg>
          <svg v-else-if="item.icon === 'database'" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="5" rx="7" ry="3" /><path d="M5 5v7c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 12v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7" /></svg>
          <svg v-else viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.1 2.1-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-3v-.2a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-2.1-2.1.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H5v-3h.2a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1L8.5 6l.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V4.6h3v.2a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 2.1 2.1-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v3h-.2a1.7 1.7 0 0 0-1.4 1Z" /></svg>
          {{ item.label }}
        </RouterLink>
      </nav>

      <div v-if="activeChat && sessions.length" class="history">
        <p>Recent conversations</p>
        <RouterLink v-for="session in sessions" :key="session.id" :to="`/chat?id=${session.id}`" class="history-item" :class="{ selected: route.query.id === session.id }">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15a4 4 0 0 1-4 4H8l-4 3v-7a4 4 0 0 1-2-3.5V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z" /></svg>
          <span>{{ session.title }}</span>
        </RouterLink>
      </div>

      <div class="sidebar-footer">
        <span class="status-dot"></span>
        <span>Local index online</span>
      </div>
    </aside>

    <main class="main-panel"><RouterView :key="route.fullPath" /></main>
  </div>
</template>
